# Xpansion 60 — required environment variables
#
# In Railway, set these in the service Variables tab.
# For local development, copy this file to .env (gitignored) and fill in values.

# --- Required ---
NODE_ENV=production
DATABASE_URL=postgresql://user:pass@host:5432/dbname
SESSION_SECRET=generate-with-openssl-rand-hex-32
APP_URL=https://www.xpansion60.com

# --- Initial admin (seeded on first boot if no matching user exists) ---
ADMIN_EMAIL=john@xpansioncode.com
ADMIN_PASSWORD=change-this-on-first-login

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=coaching@xpansion60.com

# --- Optional, defaults to 5000 ---
# PORT=5000
